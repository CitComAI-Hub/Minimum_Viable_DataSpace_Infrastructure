# Tailscale OAuth Client credentials
# Genera estas credenciales en: https://login.tailscale.com/admin/settings/oauth
# Scopes necesarios: Devices Core (Read & Write), Auth Keys (Read & Write)
# Tags: tag:k8s-operator
#
# Requisitos de la Tailnet (https://login.tailscale.com/admin/dns):
#   - MagicDNS y HTTPS Certificates habilitados (TLS automático de los Ingress)
#   - En la ACL: "tagOwners": { "tag:k8s-operator": [] }

tailscale_oauth_client_id     = "kxxxxxxCNTRL"
tailscale_oauth_client_secret = "tskey-client-kxxxxxxCNTRL-xxxxxxxxxxxxxxxxxxxxxxxx"
