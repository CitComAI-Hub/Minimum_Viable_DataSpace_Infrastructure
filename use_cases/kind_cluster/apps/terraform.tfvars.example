# Tailscale OAuth Client credentials
# Generate them at: https://login.tailscale.com/admin/settings/oauth
# Required scopes: Devices Core, Auth Keys and Services (all Read & Write)
# Tags: tag:k8s-operator
#
# Tailnet requirements:
#   - MagicDNS and HTTPS Certificates enabled (https://login.tailscale.com/admin/dns)
#   - In the policy file (https://login.tailscale.com/admin/acls):
#       "tagOwners": {
#         "tag:k8s-operator": ["autogroup:admin"],
#         "tag:k8s":          ["tag:k8s-operator"]
#       },
#       "autoApprovers": {
#         "services": { "tag:k8s": ["tag:k8s"] }
#       }

tailscale_oauth_client_id     = "kxxxxxxCNTRL"
tailscale_oauth_client_secret = "tskey-client-kxxxxxxCNTRL-xxxxxxxxxxxxxxxxxxxxxxxx"

# Let's Encrypt staging certificates: no weekly limit, but not publicly trusted
# (browsers block them, ts.net is HSTS preloaded). Production (default) allows
# 5 certificates per hostname per week, and each cluster rebuild requests new ones.
# tailscale_letsencrypt_staging = false
